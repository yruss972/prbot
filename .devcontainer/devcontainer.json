{
    "name": "Gemini Standard Dev Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "mounts": [
        "source=${localEnv:HOME}/.gemini,target=/home/vscode/.gemini,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly"
    ],
    // Features: Modular installation of tools.
    // - docker-outside-of-docker: Enables sharing the host Docker socket (for pre-commit/trivy).
    // - common-utils: Standard sets of tools like git, zsh.
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "enableNonRootDocker": "true",
            "moby": "true"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "configureZshAsDefaultShell": "true",
            "installGit": "true",
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22",
            "installYarnUsingApt": false
        },
        "ghcr.io/devcontainers/features/terraform:1": {
            "version": "1.12",
            "installTFsec": true,
            "installTerraformDocs": true
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12"
        }
    },
    // Configurations for VS Code
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "timonwong.shellcheck",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                "python.defaultInterpreterPath": ".venv/bin/python",
                "ruff.interpreter": [
                    ".venv/bin/python"
                ],
                // Match standards/vscode.template settings
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll": "explicit",
                    "source.organizeImports": "explicit"
                },
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true
            }
        }
    },
    // Use 'vscode' user (created by base image) for development
    "remoteUser": "vscode"
}
